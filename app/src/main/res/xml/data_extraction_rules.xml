<?xml version="1.0" encoding="utf-8"?>
<!--
  The enrollment (including its private signing key) is stored in SharedPreferences. Keep it
  on this device: a restored enrollment would point at a push token that belongs to another one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
